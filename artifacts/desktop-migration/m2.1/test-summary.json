  "relaunch_race": {
    "root_cause": "TinyJS bridge.js lets a relaunched instance poll the previous single-instance pipe for only 5 s; the new instance then hands off to the old app and exits. If the old app's WebView2 shutdown takes longer, no app remains.",
    "pre_fix_symptom": {
      "observed": "first isolated updater install: install returned true and the new exe was in place, but 'relaunched instance did not appear' after 120 s",
      "note": "The swap itself had succeeded; this was a relaunch handoff failure, not an EBUSY."
    },
    "isolated_race_probe": {
      "method": "start app A, spawn launcher --spawn <exe> --tinyjs-relaunched, leave A alive for 9 s, then close A",
      "observed": "B shell pid 16276 present at 1 s; absent at 9 s; A still alive; after closing A no B instance remained",
      "conclusion": "5 s pipe wait expires and B hands off/exits while A is still shutting down"
    },
    "fix": "In main.js, before createApp's single-instance check, a --tinyjs-relaunched instance polls the same user-scoped app pipe for up to 30 s. It starts as soon as the pipe is free; stock handoff behavior and security are unchanged.",
    "post_fix_evidence": {
      "install_run_relaunch_wait": [
        {
          "stage": "relaunch_wait_begin",
          "t": 1793024583.235,
          "dt": 0.009,
          "pid": 14896,
