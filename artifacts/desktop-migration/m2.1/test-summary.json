        },
        {
          "stage": "relaunch_wait_done",
          "t": 1793024583.364,
          "dt": 0.138,
          "pid": 14896,
          "waited_ms": 129
        }
      ],
      "install_run_sidecar_and_swap": [
        {
          "stage": "update_sidecar_stop_begin",
          "t": 1793024484.985,
          "dt": 26.544,
          "pid": 1000
        },
        {
