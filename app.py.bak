    """رویدادهای تعدیل — از همان منطق /api/chart (APF + gap-detection) reuse میشود."""
    try:
        import test_tsetmc  # noqa — نه لازم؛ فقط اگر importError
    except Exception:
        pass
    try:
        j = get_chart_tsetmc(symbol)
        return j.get("adjustEvents") or []
