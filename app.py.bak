# ---------------------------------------------------------------------------
# Path & configuration constants -- single source of truth.
#
# Everything here is resolved relative to APP_DIR (the repo root, which is also
# the folder the packaged EXE expects market.db / *.json to sit in -- see
# scripts/build_exe.py and bors_entry.py). Runtime state files (sync_status,
# market_sync, codal_control, sync_summary) are written by app.py,
# test_tsetmc.py and codal_fetcher.py independently, so they must keep
# resolving to this same directory; do not relocate them into a subdir.
# ---------------------------------------------------------------------------
APP_DIR = os.path.dirname(os.path.abspath(__file__))

DB_PATH = "../market.db" if os.path.exists("../market.db") else "market.db"
