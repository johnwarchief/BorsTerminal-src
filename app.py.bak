# ============ v9.7.5 فاز ۱ — داشبورد وضعیت بازار، محاسبه از market.db ============
# این مسیرها جانشینِ پروکسیِ تریدرزآرنا شده‌اند: همان پنل‌ها، اما از
# market_watch + client_type + instrumentsِ خودِ بانک. تنها چیزی که از بیرون
# نمی‌آید «عدد» است؛ خطِ زمانِ درون‌روزی از mstat_snap خوانده می‌شود که هر
# همگام‌سازی یک نقطه‌اش می‌کند (بازار که بسته باشد، تایم‌لاین آماده نیست و
# UI همین را می‌گوید — عددِ جعلی روی نمودار نمی‌نشیند).
import mstat_engine as _mstat


def _mstat_call(fn, *args, **kw):
    """یک اتصال، یک فراخوانی، همیشه بسته. خطای موتور ⇒ status=error نه ۵۰۰،
    چون یک پنلِ خراب نباید کل تب وضعیت بازار را از کار بیندازد."""
    conn = get_db()
    try:
        out = fn(conn, *args, **kw)
        out.setdefault("source", "local:market.db")
        return out
    except Exception as e:
        return {"status": "error", "message": str(e), "source": "local:market.db"}
    finally:
        conn.close()


