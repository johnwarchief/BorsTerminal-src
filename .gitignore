# ============================================================
#  BorsTerminal_Ultimate — .gitignore
#  دسته‌بندی: Python | بسته‌بندی | رازها | دیتا | وضعیت اجرا |
#             لاگ | اسکرچ | ویرایشگر
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- محیط مجازی / خروجی بسته‌بندی ----
venv/
venv_*/
*venv/
.venv/
env/
build/
dist/
portable/
releases/
android/
backups/
.v2cache/
*.spec.bak

# ---- رازها و تنظیمات دستگاه (محلی — هرگز commit نشود) ----
.env
.env.*
*.pem
*.key
*.tauri_updater_key*
.tauri/
installer/.setup_password.iss
installer/.setup_password
adb_config.json
xray_config.json
v2ray*.json
sb_config.local.json
src-tauri/target/
frontend/src-tauri/target/

# ---- دیتابیس و کش (بازسازی‌شدنی؛ حجم بالا) ----
*.db
*.db-shm
.cline_state/

*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.lzma
*.rar
*.zip
*.7z

# ---- وضعیت زمان اجرا (توسط syncها بازنویسی می‌شود) ----
market_sync.json
sync_status.json
sync_ondemand.json
sync_summary.json
codal_state.json
codal_control.json
dev/fts_update_state.json
# یادداشتِ چرخشِ IP: کدام متدِ ADB آخرین بار جواب داده (dev/codal_fts_updater
# آن را مینویسد تا دفعهٔ بعد همان را اول امتحان کند) — حالتِ دستگاه، نه کد.
dev/fts_rotate_memo.json

# ---- لاگ و خروجی ابزار ----
logs/
*.log
*.err
*.out
*.tmp
*.bak
# app.py.bak = the pristine pre-refactor monolith, kept deliberately as the
# audit trail for MIGRATED_LINES.txt and the api/ split. It must stay
# UNignored: CI's repo-hygiene job fails on any tracked-but-ignored file.
!app.py.bak
WT

# ---- اسکرچ توسعه ----
dev/_*
# فایل‌های موقت ریشه با پیشوند _ و پسوند متنی.
# عمداً «/_*» خالی نیست: آن حالت «__pycache__/» را هم می‌گرفت و
# هر فایل مشروعِ ریشه‌ای با پیشوند _ را بی‌صدا نادیده می‌زد.
/_*.txt
/_*.json
/_*.log
/_*.py
/_*.md

# ---- ویرایشگر / سیستم ----
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# ---- ابزار ایجنت (Agent Browser) ----
# خروجی ضبط/اسکرینشات/موسیقی ابزار خودکار: هرگز بخشی از مخزن نیست.
.agent_browser/
screenshots/
music_cache/
recordings/
node_modules/

# ---- رسانهٔ تولیدشده (ویدیو/صدا) ----
*.webm
*.mp4
*.mp3

# ---- پوشش تست ----
.coverage
coverage.xml
htmlcov/

# ---- کرشداپ پایتون روی ویندوز ----
*.stackdump

nimbalyst-local/attachments/

# ---- نصب‌کننده (خروجی بیلد) ----
installer/out/
build/
dist/
# second/alternate PyInstaller output trees (same nature as dist/, ~340 MB)
dist2/
# generated at publish-time by scripts/publish_github_release.py, uploaded to
# the GitHub release; never tracked in the repo
latest.json
# scratch DB backups written by the rebuild/migration scripts (market.db.pre_*).
# They are ~100 MB each and are pure local rollback state — never a commit target.
market.db.pre_*
# manual pre-migration snapshots (market.db.bak-<tag>) — same nature, local only
market.db.bak-*

# codal snapshot signature — uploaded to the release beside codal.db.lzma
# (the .lzma itself is covered by *.lzma below); never tracked
codal.db.lzma.sig


*.lzma
releases/
.cluster/
.opencode/
*.screener_cache.json
.screener_cache.json
BorsTerminal_Ultimate_Setup_*.spec
_audit/_screen_*.json
frontend/_audit/


# incremental TS build cache - regenerated by every tsc/vite run, pure merge noise
tsconfig.tsbuildinfo
*.tsbuildinfo
_audit/ra-profile/
# Reference Parity (کارِ #73): پاسخِ خامِ رهاورد/تپ‌سیت‌مک و گزارشِ ۹ تا ۳۱ مگابایتیِ هر
# اجرا بازتولیدشدنی‌اند (`python tools/ra_parity.py --symbols "$(cat
# _audit/parity_symbols.txt)" --timeframes 0,1,2 --basis last,closing`). ابزارِ تحلیل و
# جمع‌بندیِ کوچکِ آن (`_audit/parity_root_cause.json`) درِ گیت می‌ماند.
_audit/ra_probe_cache/
_audit/parity_event_csv/
_audit/ra_parity_run*.log
_audit/ra_parity_report_after.json
_audit/ra_parity_report_v*.json
_audit/ra_parity_smoke.json
_audit/ra_parity_eracheck.json
_audit/ra_parity_volcheck.json
_audit/ra_parity_foolad_pars.json
# گزارشِ اجرایِ مرجع درِ گیت می‌ماند (همان چیزی که §۱-ح به آن ارجاع می‌دهد)؛ فقط
# ستونِ `table` (نمونۀ ۴۲هزار سطری) حذف می‌شود و با همان فرمانِ بالا بازتولید است.
!_audit/ra_parity_report.json
_audit/last_blast_radius/csv_cache/
_audit/last_blast_radius/fetch_stats.json
_audit/last_blast_radius/partial.jsonl
price_basis.json

# Indicator Contract (ممیزیِ اندیکاتورها): دو خروجیِ بزرگِ میانیِ بازتولیدپذیر —
# `python _audit/indicator_audit/make_dataset.py && node _audit/indicator_audit/js_run.mjs`
# (candles.json ≈۳٫۷MB از CSVهایِ کش‌شده، ts_out.json ≈۴۸MB خروجیِ ریاضیِ فرانت).
# اسکریپت‌ها و report.json/causes.json/table.txt درِ گیت می‌مانند.
_audit/indicator_audit/candles.json
_audit/indicator_audit/ts_out.json
_audit/indicator_audit/__pycache__/

# ---- Regenerable audit output ----
_audit/*.json
!_audit/ra_parity_report.json
!_audit/parity_root_cause.json
