# npm 7+ نصبِ خودکارِ peer و داوریِ سخت‌گیرانۀ آن‌ها را انجام می‌دهد و اینجا دو بار
# ریلز را کشت (نکتۀ CIِ v1.0.39: jobِ release-inno در `npm ci` می‌مرد):
#  ۱) react-klinecharts-ui peerِ «react-klinecharts» را اجباری اعلام کرده، ولی تنها
#     زیرمسیری که آن را import می‌کند ./chart است و کدِ ما هرگز از آن استفاده
#     نمی‌کند (فقط پکیج اصلی و /extensions) -- پس peerِ اعلامی برایِ ما وجود ندارد.
#  ۲) @pairlens/fast-financial-charts (موتورِ دومِ engine-lab) peerهای optionalِ
#     «react >= 19» می‌خواهد، در حالی که برنامه رویِ React 18 ساخته شده است.
# legacy-peer-deps یعنی «هر دو را بی‌اعتبار بشمار»: npm ci فقط درختِ قفل‌شده را
# نصب می‌کند، نه چیزِ دیگری. این تنها راهی است که local و CI دقیقاً یک درخت
# می‌گیرند -- وگرنه lockی که دستی نوشته شده درِ CI بازتفسیر می‌شود و می‌شکند.
legacy-peer-deps=true
