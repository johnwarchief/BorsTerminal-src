import { pathToFileURL } from 'node:url';
const PKG = process.env.JEV_BROWSER_DIR || 'C:/Users/PCMOD/.cline/plugins/_installed/official/jev-browser-b15ae305f536/package';
const { chromium } = await import(pathToFileURL(`${PKG}/node_modules/playwright/index.mjs`).href);
const b = await chromium.launch({ headless: true, executablePath: process.env.JEV_CHROME || undefined });
const c = await b.newContext({ viewport: { width: 1366, height: 768 } });
await c.addInitScript(() => { try { sessionStorage.setItem('bors_auth_session', 'true'); } catch { /* noop */ } });
const p = await c.newPage();
const msgs: string[] = [];
p.on('console', (m) => msgs.push(m.type() + ': ' + m.text().slice(0, 160)));
p.on('pageerror', (e) => msgs.push('PAGEERROR: ' + String(e).slice(0, 300)));
p.on('requestfailed', (r) => msgs.push('REQFAIL: ' + r.url().slice(0, 110) + ' ' + (r.failure()?.errorText || '')));
const target = process.argv[2] || 'http://localhost:5173/#/master';
await p.goto(target, { waitUntil: 'domcontentloaded' });
await p.waitForTimeout(Number(process.argv[3] || 25000));
console.log('URL', p.url());
console.log('testid count', await p.evaluate(() => document.querySelectorAll('[data-testid]').length));
const ids = await p.evaluate(() => Array.from(document.querySelectorAll('[data-testid]')).slice(0, 25).map((e) => (e as HTMLElement).dataset.testid));
console.log('first testids', JSON.stringify(ids));
console.log('bodyHead', (await p.evaluate(() => document.body.innerText)).slice(0, 400).replace(/\n+/g, ' | '));
await b.close();
console.log('--- messages ---');
console.log(msgs.slice(0, 15).join('\n'));
