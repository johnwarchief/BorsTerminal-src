{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BorsTerminal M1 Shell",
  "version": "0.1.0",
  "identifier": "com.borsterminal.m1shell",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "BorsTerminal — M1 Prototype",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "url": "http://127.0.0.1:8105/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
