{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BorsTerminal M2 Shell",
  "version": "0.2.0",
  "identifier": "com.borsterminal.m2shell",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "بورس‌ترمینال — BorsTerminal",
