# ==============================================================================
# BorsTerminal Producer Environment Configuration Template
# Copy this file to producer.env and configure secrets and runtime options.
# ==============================================================================

# GitHub Personal Access Token (PAT) with repo release upload permissions.
# Required only for `bors-producer codal publish`.
GITHUB_TOKEN=ghp_your_github_token_here

# Minisign secret key string used to sign snapshot sets and release manifests.
# BORS_MINISIGN_SECRET_KEY takes highest precedence.
# Alternatively, MINISIGN_SECRET_KEY is supported as a fallback alias.
BORS_MINISIGN_SECRET_KEY=

# Path to Minisign secret key file on disk (alternative to inline secret key).
# BORS_MINISIGN_KEY_FILE takes precedence over MINISIGN_KEY_FILE.
# BORS_MINISIGN_KEY_FILE=/etc/bors-producer/minisign.key

# Password for encrypted Minisign secret key. Leave blank if the key has no password.
# BORS_MINISIGN_PASSWORD takes precedence over MINISIGN_PASSWORD.
BORS_MINISIGN_PASSWORD=

# Structured logging level: debug, info, warn, error
LOG_LEVEL=info

# Structured logging output format: json or text
LOG_FORMAT=json
